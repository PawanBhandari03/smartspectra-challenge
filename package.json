{
  "name": "crossroads",
  "version": "0.1.0",
  "description": "CrossRoads: a decision moment. Imagine living each of two options while your webcam reads your pulse, blinks and expressions (Presage SmartSpectra SDK); see honestly where your body reacted.",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && node scripts/start.js",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "node scripts/build.js && electron-builder --win"
  },
  "author": "Pawan Bhandari",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@smartspectra/node-sdk": "^3.5.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  },
  "homepage": "https://github.com/PawanBhandari03/smartspectra-challenge",
  "build": {
    "appId": "com.pawanbhandari.crossroads",
    "productName": "CrossRoads",
    "copyright": "Copyright (c) 2026 Pawan Bhandari",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "package.json",
      "src/**/*",
      "dist/**/*",
      "assets/**/*",
      "samples/**/*",
      "!**/*.map",
      "!node_modules/@smartspectra/node-sdk-darwin-arm64/**",
      "!node_modules/@smartspectra/node-sdk-linux-x64/**",
      "!node_modules/@smartspectra/node-sdk-linux-arm64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CrossRoads-Setup-${version}.exe",
      "shortcutName": "CrossRoads"
    },
    "portable": {
      "artifactName": "CrossRoads-Portable-${version}.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "npmRebuild": false
  }
}
